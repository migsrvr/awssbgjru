GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_EVAL_MODEL=openai/gpt-oss-120b
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60
CACHE_TTL=300

# Supabase (free tier)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Application Base URL & CORS (set to https://awssbgjru.me in production on EC2)
APP_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=https://awssbgjru.me,https://www.awssbgjru.me
DOMAIN=localhost

# Email notification (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_app_password
NOTIFY_EMAIL=notifications@example.com

# Built-in Executive Account (zero Supabase setup; leave blank to disable)
EXECUTIVE_USERNAME=executive
EXECUTIVE_PASSWORD=replace_with_strong_executive_password
EXECUTIVE_FULL_NAME=AWS SBG Executive
EXECUTIVE_SECRET=replace_with_long_random_hmac_secret
EXECUTIVE_SESSION_TTL_HOURS=12
